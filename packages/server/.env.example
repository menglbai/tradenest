# ================================================================================
# TradeNest 配置文件
# 使用方法：cp .env.example .env，然后按需修改
# ================================================================================
#
# 【两种使用场景】
#
# 场景 A：使用公司内部 LLM 网关（需要公司 VPN）
#   → 填写 TRADENEST_GATEWAY_BASE_URL / TRADENEST_GATEWAY_EXTRA_HEADERS
#   → 不需要填 ANTHROPIC_API_KEY
#
# 场景 B：使用公网 Anthropic API（需要自己的 API Key）
#   → 把 TRADENEST_GATEWAY_BASE_URL 改为 https://api.anthropic.com
#   → 填写 ANTHROPIC_API_KEY
#   → TRADENEST_GATEWAY_EXTRA_HEADERS 填 {}
#
# ================================================================================


# ── LLM 网关地址 ────────────────────────────────────────────────────────────────
#
# 场景 A（内部网关）：http://codewiz.devops.xiaohongshu.com/llmadapter/anthropic
# 场景 B（公网直连）：https://api.anthropic.com
#
TRADENEST_GATEWAY_BASE_URL=http://codewiz.devops.xiaohongshu.com/llmadapter/anthropic


# ── 认证方式（二选一）──────────────────────────────────────────────────────────
#
# 【场景 A：内部网关】
#   在 TRADENEST_GATEWAY_EXTRA_HEADERS 里填 x-adapter-api-key
#   ANTHROPIC_API_KEY 留空即可
#
# 【场景 B：公网 Anthropic】
#   填 ANTHROPIC_API_KEY（anthropic 库会自动识别此变量）
#   TRADENEST_GATEWAY_EXTRA_HEADERS 填 {} 即可
#
ANTHROPIC_API_KEY=


# ── 内部网关专用请求头（场景 A 必填，场景 B 填 {} ）──────────────────────────
#
# 格式：JSON 字符串（注意双引号）
# 场景 A 示例：{"x-adapter-api-key":"你的key","x-adapter-source":"tradenest"}
# 场景 B 示例：{}
#
# x-adapter-api-key: 内部网关的认证 key（找平台负责人要）
# x-adapter-source:  请求来源标识，随便填个名字（用于网关侧统计）
#
TRADENEST_GATEWAY_EXTRA_HEADERS={"x-adapter-api-key":"jCJvIWUsyXpcoxdGe61e1yfJ2N8pL4ai","x-adapter-source":"tradenest"}


# ── 用户标识（可选，内部网关用于日志追踪）────────────────────────────────────
#
# 填你的工号邮箱，或留空
#
TRADENEST_GATEWAY_USER_EMAIL=


# ── 默认模型 ──────────────────────────────────────────────────────────────────
#
# 内部网关支持的模型 ID（跟网关侧对齐）
# 公网 Anthropic 用 claude-opus-4-5 / claude-sonnet-4-5 等
#
TRADENEST_DEFAULT_MODEL=claude-4.6-sonnet-google


# ── 行情数据源优先级 ──────────────────────────────────────────────────────────
#
# 逗号分隔，靠前的优先，失败自动降级到下一个
# 可选值：tencent（腾讯）/ sina（新浪）/ ths（同花顺）/ eastmoney（东方财富）
#
# 推荐配置：
#   tencent,sina,ths        → 默认，三家均可用，速度快
#   ths,tencent,sina        → 同花顺优先（习惯用同花顺的用户）
#   eastmoney,tencent,sina  → 东财优先（部分环境下东财可用）
#
TRADENEST_QUOTE_SOURCES=tencent,sina,ths


# ── HTTP 代理（可选）──────────────────────────────────────────────────────────
#
# 如果你的网络环境需要走代理才能访问 LLM 或行情数据，在这里填
# 留空 = 不使用代理
#
# 示例：http://127.0.0.1:7890
#
TRADENEST_HTTP_PROXY=
TRADENEST_HTTPS_PROXY=


# ── 服务器配置（本地开发一般不用改）─────────────────────────────────────────
#
TRADENEST_HOST=0.0.0.0
TRADENEST_PORT=8000
TRADENEST_DEBUG=false
