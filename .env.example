# TradeNest 环境变量配置示例
# 复制为 .env 后填入真实值
# cp .env.example .env

# ============================================================
# LLM Provider
# ============================================================

# 默认使用哪个 Provider（小红书内部 codewiz 网关，不需要 API key）
TRADENEST_DEFAULT_PROVIDER_ID=internal-xhs

# 小红书内部 codewiz 网关
TRADENEST_XHS_INTERNAL_BASE_URL=http://codewiz.devops.xiaohongshu.com/llmadapter/anthropic
TRADENEST_XHS_INTERNAL_USER_EMAIL=your_email@xiaohongshu.com

# 公网 Anthropic（不在小红书内网时用）
# TRADENEST_DEFAULT_PROVIDER_ID=anthropic-public
# TRADENEST_ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxx

# DeepSeek（性价比之选）
# TRADENEST_DEFAULT_PROVIDER_ID=deepseek
# TRADENEST_DEEPSEEK_API_KEY=sk-xxxxxxxxxx

# OpenAI
# TRADENEST_DEFAULT_PROVIDER_ID=openai
# TRADENEST_OPENAI_API_KEY=sk-xxxxxxxxxx

# ============================================================
# 行情数据源（实时行情优先级）
# ============================================================

# 逗号分隔，按顺序尝试，前一个失败自动降级到下一个
# 可选值:
#   tencent   腾讯行情（qt.gtimg.cn）    稳定，字段全
#   sina      新浪行情（hq.sinajs.cn）   稳定，备用
#   ths       同花顺行情（d.10jqka.com.cn）稳定，含分时均价
#   eastmoney 东方财富（AkShare）         可能被反爬，兜底
TRADENEST_QUOTE_SOURCES=tencent,sina,ths

# ============================================================
# 应用配置
# ============================================================

TRADENEST_DEBUG=true
TRADENEST_LOG_LEVEL=INFO
TRADENEST_PORT=8000

# Agent 最大循环轮数（防止死循环）
TRADENEST_AGENT_MAX_LOOP_TURNS=10

# ============================================================
# HTTP 代理（如需要）
# ============================================================

# HTTPS_PROXY=http://your-proxy:port
# HTTP_PROXY=http://your-proxy:port
# NO_PROXY=localhost,127.0.0.1,xiaohongshu.com
